# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://localhost:8081,http://localhost:8082"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenAI-compatible LLM Settings
FUND_LLM_PROVIDER=deepseek
FUND_LLM_BASE_URL=https://api.deepseek.com
FUND_LLM_API_KEY="your-llm-api-key"
FUND_LLM_MODEL=deepseek-v4-flash
FUND_LLM_TEMPERATURE=0.2
FUND_LLM_MAX_TOKENS=4096
FUND_LLM_TIMEOUT_SECONDS=120
MAX_LLM_CALL_RETRIES=3
SESSION_NAMING_ENABLED=true

# OpenAI-compatible Embedding Settings
FUND_EMBEDDING_PROVIDER=openai_compatible
FUND_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY="your-embedding-api-key"
FUND_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
FUND_EMBEDDING_DIM=1024
FUND_EMBEDDING_TIMEOUT_SECONDS=60

# Long-term Memory Settings
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_MODEL=deepseek-v4-flash
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory
MEM0_DIR=.runtime/mem0
MEM0_TELEMETRY=false

# JWT Settings
JWT_SECRET_KEY="CHANGE_ME_TO_A_RANDOM_32_PLUS_CHAR_STRING"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=1

# Database Settings
POSTGRES_HOST=localhost
POSTGRES_DB=fund_agent
POSTGRES_USER=root
POSTGRES_PORT=5432
POSTGRES_PASSWORD="change-me"
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ---- Context / cache (added by context-engine work) ----
AGENT_STATUS_ENABLED=true
BATCH_COMPACTION_ENABLED=true
CACHE_TTL_SECONDS=60
CONTEXT_STRATEGY=structured
CONVERSATION_SUMMARY_ENABLED=true
DUPLICATE_TOOL_GUARD_ENABLED=true
DUPLICATE_TOOL_MAX_SAME_CALLS=2
FUND_CONTEXT_TOKEN_BUDGET=16384
FUND_LLM_PROFILES=[{"name":"智谱 GLM","model":"glm-5.3-flash","base_url":"https://open.bigmodel.cn/api/paas/v4/","api_key":"YOUR_API_KEY"}]
SUMMARY_MERGE_FRACTION=0.5
# Basic model shared by authenticated users (read-only in client settings)
FUND_BASIC_LLM_MODEL=glm-5.3-flash
FUND_BASIC_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
FUND_BASIC_LLM_API_KEY=
# Keep this server key stable; if empty, JWT_SECRET_KEY is used for encryption.
# Changing it requires re-encrypting personal credentials or entering them again.
FUND_LLM_PROFILE_ENCRYPTION_KEY=

# 中国大陆民用节假日在线数据源（无需 Key，地址仅由服务端配置）
FUND_HOLIDAY_API_BASE_URL=https://timor.tech/api/holiday
FUND_HOLIDAY_API_TIMEOUT_SECONDS=8
SUMMARY_REGION_MAX_RATIO=0.30
SUMMARY_SEGMENT_MERGE_COUNT=8
TOOL_MESSAGE_HARD_LIMIT_TOKENS=4000
VALKEY_DB=
VALKEY_HOST=
VALKEY_MAX_CONNECTIONS=
VALKEY_PASSWORD=
VALKEY_PORT=
